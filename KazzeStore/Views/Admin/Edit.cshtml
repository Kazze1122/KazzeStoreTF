@model KazzeStore.Models.Product
@{
    ViewData["Title"] = "Editar Polo";
}
<div class="container mt-4"
     style="padding-top:45px;">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h2 class="mb-2">Editar Producto</h2>
            <hr class="mb-2" />
            <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editForm">
                <input type="hidden" asp-for="Id" />
                <div class="row">
                    <div class="col-md-5">
                        <div class="row">
                            <div class="col-12 mb-2">
                                <label asp-for="Nombre" class="form-label fw-semibold"></label>
                                <input asp-for="Nombre" class="form-control" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Imagen Actual:</label>
                            <div class="text-center border p-2 bg-light rounded">
                                <img id="currentImage" src="@Model.ImagenUrl" alt="@Model.Nombre"
                                     class="img-fluid rounded"
                                     style="max-height: 200px; object-fit: contain;" />
                            </div>
                        </div>
                        <div class="mb-1">
                            <label class="form-label fw-semibold">Nueva Imagen (opcional)</label>
                            <input type="file" name="ImagenArchivo" id="imagenInput"
                                   class="form-control" accept="image/*" />
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="mb-2">
                            <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                            <select asp-for="CategoryId" class="form-select" required>
                                <option value="">Selecciona una categoría</option>
                                <option value="1" selected="@(Model.CategoryId == 1)">Anime</option>
                                <option value="2" selected="@(Model.CategoryId == 2)">Kanjis</option>
                                <option value="3" selected="@(Model.CategoryId == 3)">Minimalista</option>
                            </select>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label asp-for="Precio" class="form-label fw-semibold"></label>
                                <input asp-for="Precio" class="form-control" type="number" step="0.01" required />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label asp-for="Stock" class="form-label fw-semibold"></label>
                                <input asp-for="Stock" class="form-control" type="number" required />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="form-label fw-semibold">Tallas Disponibles</label>
                                <div class="d-flex gap-2 flex-wrap">
                                    <div class="form-check">
                                        <input type="checkbox" name="Tallas" value="S" class="form-check-input"
                                               checked="@(ViewBag.SelectedTallas.Contains("S"))" />
                                        <label class="form-check-label">S</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" name="Tallas" value="M" class="form-check-input"
                                               checked="@(ViewBag.SelectedTallas.Contains("M"))" />
                                        <label class="form-check-label">M</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" name="Tallas" value="L" class="form-check-input"
                                               checked="@(ViewBag.SelectedTallas.Contains("L"))" />
                                        <label class="form-check-label">L</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" name="Tallas" value="XL" class="form-check-input"
                                               checked="@(ViewBag.SelectedTallas.Contains("XL"))" />
                                        <label class="form-check-label">XL</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" name="Tallas" value="XXL" class="form-check-input"
                                               checked="@(ViewBag.SelectedTallas.Contains("XXL"))" />
                                        <label class="form-check-label">XXL</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label fw-semibold">Color</label>
                                <select asp-for="Color" class="form-select" required>
                                    <option value="">Selecciona un color</option>
                                    <option value="Blanco" selected="@(Model.Color == "Blanco")">Blanco</option>
                                    <option value="Negro" selected="@(Model.Color == "Negro")">Negro</option>
                                    <option value="Rojo" selected="@(Model.Color == "Rojo")">Rojo</option>
                                    <option value="Gris" selected="@(Model.Color == "Gris")">Gris</option>
                                    <option value="Verde Oscuro" selected="@(Model.Color == "Verde Oscuro")">Verde Oscuro</option>
                                    <option value="Azul Oscuro" selected="@(Model.Color == "Azul Oscuro")">Azul Oscuro</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="mb-2 d-flex justify-content-center gap-3">
                            <button type="submit" class="btn btn-primary ">Guardar Cambios</button>
                            <a asp-action="Products" class="btn btn-secondary ">Cancelar</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    document.getElementById('editForm').addEventListener('submit', function (e) {
        const tallasChecked = document.querySelectorAll('input[name="Tallas"]:checked').length;
        if (tallasChecked === 0) {
            e.preventDefault();
            alert("Debes seleccionar al menos una talla.");
            return;
        }
        if (!this.checkValidity()) {
            e.preventDefault();
            alert("Todos los campos son obligatorios. Por favor, completa el formulario.");
        }
    });

    document.getElementById('imagenInput').addEventListener('change', function (e) {
        if (e.target.files && e.target.files[0]) {
            const reader = new FileReader();
            reader.onload = function (event) {
                document.getElementById('currentImage').src = event.target.result;
            };
            reader.readAsDataURL(e.target.files[0]);
        }
    });
</script>