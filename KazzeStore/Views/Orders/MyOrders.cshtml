@model IEnumerable<KazzeStore.Models.Order>
@{
    ViewData["Title"] = "Mis Compras";
}

<div class="container mt-5"
     style="padding-top:25px ; padding-bottom:45px;">
    <h2 class="mb-4">📦 Mis Compras</h2>
    @if (Model.Any())
    {
        var ordersList = Model.OrderBy(o => o.Fecha).ToList(); 
        int contador = 1;
        foreach (var order in ordersList)
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">Compra #@contador</span>
                        <span class="text-muted">@order.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Lado Derecho: Productos -->
                        <div class="col-md-8">
                            <p><strong>Productos:</strong></p>
                            <p class="text-muted">@order.Detalles</p>
                        </div>
                        <!-- Lado Izquierdo: Total y Estado -->
                        <div class="col-md-4 text-end">
                            <small class="text-muted">Total</small>
                            <h4 class="text-success mb-2">S/ @order.Total</h4>
                            <span class="badge bg-success fs-6">Completado</span>
                        </div>
                    </div>
                </div>
            </div>
            contador++;
        }
    }
    else
    {
        <div class="text-center py-5">
            <h4 class="text-muted">Aún no tienes compras</h4>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary mt-3">
                Ir a la Tienda
            </a>
        </div>
    }
</div>