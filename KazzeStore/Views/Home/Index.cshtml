@model IEnumerable<KazzeStore.Models.Product>
@{
    ViewData["Title"] = "KazzeStore - Polos con Kanji";
}

<div class="hero-section text-white text-center"
     style="background: linear-gradient(-180deg, #c31432 10%, #240b36 130%);

            display: flex;
            align-items: flex-start;
            padding:80px;
            padding-bottom: 50px ">


    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">


                <h1 class="display-1 fw-bold mb-2" style="font-size: 7rem; letter-spacing: -4px;">
                    KAZZE
                </h1>
                <h4 class="display-1 fw-bold mb-4" style="font-size: 2.2rem; margin-top: -20px;">
                    STORE
                </h4>


                <div class="kanji-decoration mb-4" style="font-size: 3.2rem; opacity: 0.9;">
                    風 &nbsp; 水 &nbsp; 火 &nbsp; 月 &nbsp; 天
                </div>


                <p class="lead fs-3 mb-5" style="max-width: 700px; margin: 0 auto;">
                    Polos con Kanji • Arte y Filosofía Japonesa
                </p>
                
            </div>
        </div>
    </div>
</div>