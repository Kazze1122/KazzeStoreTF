@model KazzeStore.Models.Product

@{
    ViewData["Title"] = "Eliminar Polo";
}

<div class="container mt-4"
    style="padding-top:40px">
    <h3>¿Estás seguro de eliminar este polo?</h3>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>
        <dt class="col-sm-2">Kanji</dt>
        <dd class="col-sm-10">@Model.Kanji</dd>
        <dt class="col-sm-2">Precio</dt>
        <dd class="col-sm-10">S/ @Model.Precio</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Sí, Eliminar</button>
        <a asp-action="Products" class="btn btn-secondary">Cancelar</a>
    </form>
</div>